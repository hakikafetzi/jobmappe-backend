# All environment variables the backend reads, with their default values.
# Copy this file to .env to change them.
#
# Docker Compose loads .env automatically; Spring Boot does not.
# If you change a value, set the same variable in your IntelliJ run
# configuration or shell as well.

# Database connection
# DB_HOST only needs to change if the database runs elsewhere
# (e.g. "db" when the backend runs in a container).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobmappe
DB_USER=jobmappe
DB_PASSWORD=jobmappe